{
  "expo": {
    "name": "petConecta",
    "slug": "petConecta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "petconecta",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundlerIdentifier": "com.petC.petConecta",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "package": "com.petC.petConecta",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff",
        "config": {
          "googleMaps": {
            "apiKey": "AIzaSyApGDpNKditZOFLwLxkSdG4oVRUtCP2OWA"
          }
        }
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
